# math-verl config (deploy + experiment).
#
# Single config file for everything: agl-lite deploy reads AGL_NAMESPACE/MODE/etc.
# and ignores the rest; run.sh sources this file for experiment params.

# ── Deploy ────────────────────────────────────────────────────────
AGL_NAMESPACE=agl-math-verl
AGL_MODE=agl-in-host

AGL_HOST_IP_BIND=0.0.0.0
AGL_HOST_PORT=8080

# Reuse the math-poc vLLM hooks, gateway routing, and agent pod template.
AGL_GATEWAY_CONFIG=examples/math-poc/vllm/gateway-config.yaml
AGL_HOOKS=examples/math-poc/vllm/hooks.py
AGL_POD_SPEC_TEMPLATE=examples/math-poc/job-template.yaml
AGL_LOCAL_STATE_DIR=.local

# ── Model ─────────────────────────────────────────────────────────
AGL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# ── VERL Training ─────────────────────────────────────────────────
AGL_VERL_TOTAL_STEPS=1
AGL_VERL_ROLLOUT_N=2
AGL_VERL_VAL_SIZE=5
AGL_VERL_EXPERIMENT_NAME=math_verl_smoke

# W&B scalar metrics are enabled by the trainer unless WANDB_MODE=disabled.
# Offline mode keeps W&B run data local.
WANDB_MODE=offline

# Optional pre-VERL rollout smoke check. Keep false for the default VERL flow,
# because model servers are registered by the trainer after VERL starts.
AGL_VERL_SMOKE_ROLLOUT_CHECK=false
