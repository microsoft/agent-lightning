# math-verl training env (host-side)

# agl-lite
export AGL_BASE_URL=http://localhost:8080

# model
export AGL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# training knobs
export AGL_VERL_TOTAL_STEPS=1
export AGL_VERL_ROLLOUT_N=2
export AGL_VERL_VAL_SIZE=5
export AGL_VERL_EXPERIMENT_NAME=math_verl_smoke

# serve wiring (reuse math-poc vllm assets by default)
export AGL_GATEWAY_CONFIG=examples/math-poc/vllm/gateway-config.yaml
export AGL_HOOKS=examples/math-poc/vllm/hooks.py
