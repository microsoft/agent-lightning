# ScienceWorld example — local-runner config.
#
# Sourced by run.sh. All values here are overridable via the environment.

# agl-lite serve binds to this port.
AGL_HOST_PORT=18080

# Number of concurrent rollout subprocesses (each runs its own JVM).
AGL_LOCAL_POOL_SIZE=64

# Number of GPUs VERL is allowed to use on this node (drives FSDP/vLLM placement).
AGL_N_GPUS_PER_NODE=8

# Model served via the gateway (VERL boots vLLM with this model internally).
AGL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Namespace is required by the controller CLI but unused in local mode.
AGL_NAMESPACE=local

# Comma-separated ScienceWorld task names, or 'all' for every task (30 total).
# Per-task variation budget is auto-capped at env.get_max_variations(task_name),
# so tasks with fewer than AGL_VARIATIONS_PER_TASK variations still work.
AGL_TASK_NAMES=all

# Max variations per task (split into train/val 80/20).
AGL_VARIATIONS_PER_TASK=100

# ScienceWorld simplifications — comma-separated string of flags (no spaces).
# Valid flags (per env.get_possible_simplifications()):
#   teleportAction          - teleport directly to any location
#   selfWateringFlowerPots  - flower pots water themselves
#   openContainers          - containers are open by default
#   openDoors               - doors are open by default
#   noElectricalAction      - drop `connect X to Y` actions (smaller action space)
#   easy                    - alias for all 5 above
# Use "" for the original (no-simplification) difficulty.
AGL_SIMPLIFICATION=easy

# --- SWAgent runtime (per-rollout subprocess) ---

# Max LLM turns per episode (outer agent loop).
SW_MAX_STEPS=100

# envStepLimit passed to ScienceWorldEnv (env-internal step cap).
SW_ENV_STEP_LIMIT=100

# Max number of valid actions shown to the LLM in the prompt.
# Also caps the parsed action index — keep these aligned.
SW_MAX_VALID_ACTIONS_SHOWN=50

# Length of the obs snippet stored in each `step` event.
SW_OBS_SNIPPET_CHARS=240

# --- LLM sampling ---
# Train rollouts explore (temperature > 0); val rollouts are deterministic (0.0).
# Picked per-rollout by sw_agent.py via AGL_IS_TRAIN (injected by the local controller).
AGL_TEMPERATURE_TRAIN=1.0
AGL_TEMPERATURE_VAL=0.0
AGL_MAX_TOKENS=256
