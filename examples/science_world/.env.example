# ScienceWorld example — local-runner config.
#
# Sourced by run.sh. All values here are overridable via the environment.

# agl-lite serve binds to this port.
AGL_HOST_PORT=8080

# Number of concurrent rollout subprocesses (each runs its own JVM).
AGL_LOCAL_POOL_SIZE=16

# Model served via the gateway (VERL boots vLLM with this model internally).
AGL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Namespace is required by the controller CLI but unused in local mode.
AGL_NAMESPACE=local

# Comma-separated ScienceWorld task names, or 'all' for every task (30 total).
# Per-task variation budget is auto-capped at env.get_max_variations(task_name),
# so tasks with fewer than AGL_VARIATIONS_PER_TASK variations still work.
AGL_TASK_NAMES=all

# Max variations per task (split into train/val 80/20).
AGL_VARIATIONS_PER_TASK=50

# Simplification preset (easy / medium / hard).
AGL_SIMPLIFICATION=easy
