# llm-in-sandbox local K8s + VERL config.
# Set AGL_KEY in your shell, not in this file:
#   export AGL_KEY=$(openssl rand -hex 32)

# -- Deploy ---------------------------------------------------------
AGL_NAMESPACE=agl-llm-sandbox
AGL_MODE=agl-in-host

AGL_HOST_IP_BIND=0.0.0.0
AGL_HOST_PORT=8080

AGL_GATEWAY_CONFIG=examples/llm-in-sandbox/gateway-config.yaml
AGL_HOOKS=examples/llm-in-sandbox/hooks.py
AGL_POD_SPEC_TEMPLATE=examples/llm-in-sandbox/job-template.yaml
AGL_LOCAL_STATE_DIR=examples/llm-in-sandbox/.local

# -- Model ----------------------------------------------------------
AGL_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
AGL_OPENAI_MODEL_PREFIX=openai/
AGL_LLM_TEMPERATURE=1.0
OPENAI_TIMEOUT=900
# Per-call rollout generation cap. Independent from trajectory aggregation length.
MAX_TOKENS_PER_CALL=20000

# -- Data -----------------------------------------------------------
AGL_TRAIN_DATA_DIR=examples/llm-in-sandbox/data/llm_sandbox_instruct_pretrain
AGL_TEST_DATA_DIR=examples/llm-in-sandbox/data/llm_sandbox_math_mini,examples/llm-in-sandbox/data/llm_sandbox_chem_mini

# -- VERL training --------------------------------------------------
# Smoke-friendly local defaults. Increase these for full training.
AGL_VERL_PROJECT_NAME=AgentLightning-k8s
AGL_VERL_EXPERIMENT_NAME=train_llm_in_sandbox_local
AGL_VERL_LOGGER=console
WANDB_MODE=offline
AGL_VERL_TOTAL_STEPS=1
AGL_VERL_TOTAL_EPOCHS=1
AGL_VERL_TEST_FREQ=1
AGL_VERL_SAVE_FREQ=-1
AGL_VERL_ROLLOUT_N=2
AGL_VERL_TRAIN_BATCH_SIZE=2
AGL_VERL_MINIBSZ=2
AGL_VERL_N_GPUS_PER_NODE=1
AGL_VERL_TENSOR_MODEL_PARALLEL_SIZE=1
AGL_VERL_GPU_MEMORY_UTILIZATION=0.7
AGL_VERL_VAL_BEFORE_TRAIN=false
AGL_VERL_VAL_ONLY=false
AGL_VERL_MAX_TRAIN_SAMPLES=0
AGL_VERL_MAX_TEST_SAMPLES=0
AGL_VERL_MAX_PROMPT_LENGTH=65536
AGL_VERL_MAX_RESPONSE_LENGTH=65536
# Defaults come from train_llm_in_sandbox.py unless explicitly set.
# AGL_VERL_TRAJECTORY_MAX_PROMPT_LENGTH=8000
# AGL_VERL_TRAJECTORY_MAX_RESPONSE_LENGTH=12000
AGL_VERL_TRACE_LEVEL=trajectory
AGL_VERL_LOSS_AGG_MODE=seq-mean-token-sum
AGL_ROLLOUT_TIMEOUT_SECONDS=1500
# Delete agl-lite managed K8s Jobs and gateway-registered vLLM endpoints when
# their rollout step finishes. Disable to keep Jobs around for debugging; the
# controller's ttlSecondsAfterFinished will still eventually GC them.
AGL_CLEANUP_AGENT_JOBS=true