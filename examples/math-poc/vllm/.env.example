# Math PoC — vLLM mode runtime/experiment config.
#
# Deploy config is in: examples/math-poc/vllm/deploy.env
# Run with:
#   export AGL_KEY=$(openssl rand -hex 32)
#   scripts/start_vllm.sh
#   examples/math-poc/run.sh vllm

# Model name used in agent requests and gateway routing.
# Must match the model served by vLLM.
AGL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Model endpoint as seen by host agl-lite gateway.
AGL_MODEL_ENDPOINT=http://localhost:8010/v1

# vLLM host port (checked by run.sh before starting the loop).
AGL_VLLM_PORT=8010

# scripts/start_vllm.sh parameters.
AGL_VLLM_GPU=0
AGL_VLLM_MAX_MODEL_LEN=2048
AGL_VLLM_GPU_MEM_UTIL=0.2

# Experiment settings.
AGL_BATCH_SIZE=5
AGL_NUM_ITERATIONS=1
