# Math PoC — example environment configuration.
# Copy to .env and edit before running.
#
# This file configures the PoC-specific settings (model server, dataset, etc.).
# Infrastructure settings (namespace, URLs, controller) are in deploy/.env.

# ── Mode ──────────────────────────────────────────────────────────
# "mock" = mockai echo server inside minikube (CPU-only, deterministic)
# "vllm" = real vLLM inference server on host GPUs
MODE=mock

# ── Model server ──────────────────────────────────────────────────
# Model name used in agent requests and gateway routing.
MODEL_NAME=mock-llm

# Model server endpoint (as seen from inside minikube).
#   mock mode:  http://mockai.<namespace>.svc.cluster.local:5002/v1
#   vllm mode:  http://host.minikube.internal:<vllm_port>/v1
# Leave blank to auto-derive from MODE + namespace.
# MODEL_ENDPOINT=

# vLLM-specific: port on host where vLLM is listening.
VLLM_PORT=8001
# vLLM-specific: HuggingFace model ID (for launching vLLM).
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ── Dataset ───────────────────────────────────────────────────────
# Number of rollouts per iteration.
BATCH_SIZE=5
# Number of RL iterations (mock mode does weight update between iterations).
NUM_ITERATIONS=2

# ── Agent ─────────────────────────────────────────────────────────
# Agent image (built by build_images.sh).
AGENT_IMAGE=math-agent:dev
