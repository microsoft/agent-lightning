# agl-lite + Math PoC — mockai configuration.
#
# Mock mode: all services in minikube (CPU-only, no GPU).
# Uses mockai (echo mode) as model server — deterministic, fast.
#
# Usage:
#   cp examples/math-poc/.env.mockai.example deploy/.env
#   export AGL_KEY=$(openssl rand -hex 32)
#   examples/math-poc/run.sh

# ── Infrastructure ────────────────────────────────────────────────
# Shared API key — used by all components (serve, controller, agents).
# Uncomment and set, or export AGL_KEY in your shell before deploying.
# AGL_KEY=change-me-to-a-random-key

# K8s namespace for all agl-lite resources.
AGL_K8S_NAMESPACE=agl-test

# Advertised URL of the agl-lite service (as seen from inside K8s).
AGL_BASE_URL=http://agl-lite.agl-test.svc.cluster.local:8080

# K8s Secret name holding AGL_KEY.
AGL_SECRET_NAME=agl-lite-keys

# Controller settings.
AGL_POLL_INTERVAL=10
AGL_MAX_QUEUE_TIME=3600

# ── Model server ──────────────────────────────────────────────────
# Mode: "mock" uses mockai inside minikube; "vllm" uses host vLLM.
AGL_MODEL_MODE=mock

# Model name used in agent requests and gateway routing.
AGL_MODEL_NAME=mock-llm

# Model server endpoint (as seen from inside minikube).
# For mock mode, auto-derived from namespace if left blank.
# AGL_MODEL_ENDPOINT=http://mockai.agl-test.svc.cluster.local:5002/v1

# ── Experiment ────────────────────────────────────────────────────
# Rollouts per iteration.
AGL_BATCH_SIZE=5

# Number of RL iterations (mock mode: weight update between iterations).
AGL_NUM_ITERATIONS=2

# ── Hooks ─────────────────────────────────────────────────────────
# Path to hooks module (relative to repo root).
AGL_HOOKS=examples/math-poc/mock/hooks.py
