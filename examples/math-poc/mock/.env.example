# Math PoC — mock mode config (deploy + experiment).
#
# Single config file for everything: agl-lite deploy reads AGL_NAMESPACE/MODE/etc.
# and ignores the rest; run.sh sources this file for experiment params.
#
# Usage:
#   export AGL_KEY=$(openssl rand -hex 32)
#   examples/math-poc/run.sh mock

# ── Deploy ────────────────────────────────────────────────────────
AGL_NAMESPACE=agl-test
AGL_MODE=agl-in-k8s
AGL_HOST_IP_BIND=0.0.0.0
AGL_HOST_PORT=8080

AGL_GATEWAY_CONFIG=examples/math-poc/mock/gateway-config.yaml
AGL_HOOKS=examples/math-poc/mock/hooks.py
AGL_POD_SPEC_TEMPLATE=examples/math-poc/job-template.yaml

# ── Experiment ────────────────────────────────────────────────────
# Model name used in agent requests and gateway routing.
AGL_MODEL_NAME=mock-llm

# Model endpoint as seen by pods.
# If unset, run.sh auto-derives: http://mockai.<namespace>.svc.cluster.local:5002/v1
# AGL_MODEL_ENDPOINT=http://mockai.<namespace>.svc.cluster.local:5002/v1

AGL_BATCH_SIZE=5
AGL_NUM_ITERATIONS=2

# Local port for kubectl port-forward.
AGL_LOCAL_PORT=18080
