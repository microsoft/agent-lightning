# Math PoC — mock mode runtime/experiment config.
#
# Deploy config is in: examples/math-poc/mock/deploy.yaml
# Run with:
#   export AGL_KEY=$(openssl rand -hex 32)
#   examples/math-poc/run.sh mock

# Model name used in agent requests/gateway routing.
AGL_MODEL_NAME=mock-llm

# Model endpoint as seen by pods.
# If unset in mock mode, run.sh auto-derives:
#   http://mockai.<namespace>.svc.cluster.local:5002/v1
# AGL_MODEL_ENDPOINT=http://mockai.<namespace>.svc.cluster.local:5002/v1

# Experiment settings.
AGL_BATCH_SIZE=5
AGL_NUM_ITERATIONS=2

# Local port for kubectl port-forward in mock mode.
AGL_LOCAL_PORT=18080
