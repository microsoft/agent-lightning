# agl-lite + Math PoC — vLLM configuration.
#
# vLLM mode: agl-lite infra in minikube, vLLM on host GPUs.
# Agent pods reach vLLM via host.minikube.internal.
#
# Prerequisites:
#   - minikube running (Docker driver)
#   - vLLM serving on host:
#       vllm serve Qwen/Qwen2.5-1.5B-Instruct --port 8001 --host 0.0.0.0
#
# Usage:
#   cp examples/math-poc/.env.vllm.example deploy/.env
#   export AGL_KEY=$(openssl rand -hex 32)
#   examples/math-poc/run.sh

# ── Infrastructure ────────────────────────────────────────────────
# Shared API key — used by all components (serve, controller, agents).
# Uncomment and set, or export AGL_KEY in your shell before deploying.
# AGL_KEY=change-me-to-a-random-key

# K8s namespace for all agl-lite resources.
AGL_K8S_NAMESPACE=agl-test

# Advertised URL of the agl-lite service (as seen from inside K8s).
AGL_LITE_URL=http://agl-lite.agl-test.svc.cluster.local:8080

# K8s Secret name holding AGL_KEY.
AGL_SECRET_NAME=agl-lite-keys

# Controller settings.
AGL_POLL_INTERVAL=10
AGL_MAX_QUEUE_TIME=3600

# ── Model server ──────────────────────────────────────────────────
# Mode: "mock" uses mockai inside minikube; "vllm" uses host vLLM.
AGL_MODEL_MODE=vllm

# Model name used in agent requests and gateway routing.
# Must match the model name vLLM serves (= HuggingFace model ID).
AGL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Model server endpoint (as seen from inside minikube).
# host.minikube.internal resolves to the host machine from minikube pods.
AGL_MODEL_ENDPOINT=http://host.minikube.internal:8001/v1

# vLLM host port (used by run.sh to verify vLLM is reachable).
AGL_VLLM_PORT=8001

# ── Experiment ────────────────────────────────────────────────────
# Rollouts per iteration.
AGL_BATCH_SIZE=5

# Number of RL iterations.
# vLLM mode: model is frozen, no real weight update.
# Version bump is metadata-only (validates tracking path).
AGL_NUM_ITERATIONS=1
