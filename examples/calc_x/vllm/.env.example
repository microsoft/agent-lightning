# Calc-X — vLLM mode config (deploy + experiment).
#
# Single config file for everything: agl-lite deploy reads AGL_NAMESPACE/MODE/etc.
# and ignores the rest; run.sh sources this file for experiment params.
#
# Usage:
#   export AGL_KEY=$(openssl rand -hex 32)
#   scripts/start_vllm.sh
#   examples/calc_x/run.sh

# ── Deploy ────────────────────────────────────────────────────────
AGL_NAMESPACE=agl-calcx
AGL_MODE=agl-in-host

AGL_HOST_IP_BIND=0.0.0.0
AGL_HOST_PORT=8080

AGL_GATEWAY_CONFIG=examples/calc_x/vllm/gateway-config.yaml
AGL_HOOKS=examples/calc_x/vllm/hooks.py
AGL_POD_SPEC_TEMPLATE=examples/calc_x/job-template.yaml

# ── Model ─────────────────────────────────────────────────────────
# Model name — must match the model served by vLLM.
AGL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Model endpoint as seen by the host agl-lite gateway.
AGL_MODEL_ENDPOINT=http://localhost:8010/v1

# ── vLLM ──────────────────────────────────────────────────────────
# vLLM host port (checked by run.sh before starting the loop).
AGL_VLLM_PORT=8010

# scripts/start_vllm.sh parameters.
AGL_VLLM_GPU=0
AGL_VLLM_MAX_MODEL_LEN=4096
AGL_VLLM_GPU_MEM_UTIL=0.6

# ── VERL Training ─────────────────────────────────────────────────
# Dataset paths (relative to repo root).
AGL_TRAIN_FILE=examples/calc_x/data/train.parquet
AGL_VAL_FILE=examples/calc_x/data/test.parquet
