# Agent image for calc_x example.
# Build context: examples/calc_x/
#   minikube image build -t calc-x-agent:dev -f Dockerfile.agent examples/calc_x/

FROM python:3.12-slim

# uv + uvx are needed for MCP server: `uvx mcp-server-calculator`
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:latest /uvx /usr/local/bin/uvx

RUN pip install --no-cache-dir \
    openai \
    httpx \
    "autogen-agentchat" \
    "autogen-ext[openai]" \
    "mcp>=1.10.0"

COPY agents/calc_agent.py /app/calc_agent.py

WORKDIR /app
