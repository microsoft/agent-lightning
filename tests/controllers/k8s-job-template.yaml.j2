apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ job_name }}"
spec:
  template:
    spec:
      containers:
        - name: agent
          image: "{{ input.image_name | yaml_escape }}"
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
          args:
            - sleep 20s

