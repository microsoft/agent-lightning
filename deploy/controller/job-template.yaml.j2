# K8s Job manifest scaffold — rendered by agl-lite controller (Jinja2).
#
# Two YAML documents separated by ---:
#   Document 0: Job manifest scaffold (standard K8s, containers/volumes populated from
#               the rollout's job_template resource at runtime)
#   Document 1: PodPatcher — env vars and volumes injected into ALL containers in the pod
#               (user's own env/volume entries win on name conflict)
#
# Jinja2 variables injected by job_builder:
#   job_name, rollout_id, namespace, base_url, ttl_after_finished
#
# To customise: copy this file, edit, and set AGL_JOB_MANIFEST_TEMPLATE in deploy config.

apiVersion: batch/v1
kind: Job
metadata:
  name: {{ job_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/managed-by: agl-lite
    agl-lite/rollout-id: {{ rollout_id }}
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: {{ ttl_after_finished }}
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: agl-lite
        agl-lite/rollout-id: {{ rollout_id }}
    spec:
      restartPolicy: Never
      containers: []
      volumes: []

---

# PodPatcher: injected into every container in the pod by job_builder.
# env          — prepended to each container's env list; container's own values win on name conflict.
# volume_mounts — prepended to each container's volumeMounts; container's own mounts win on name conflict.
# volumes      — merged into pod spec volumes; user's volumes win on name conflict.
env:
  - name: AGL_POD_UID
    valueFrom:
      fieldRef:
        fieldPath: metadata.uid
  - name: AGL_KEY
    valueFrom:
      secretKeyRef:
        name: agl-lite-keys
        key: AGL_KEY
        optional: true
  - name: OPENAI_API_KEY
    valueFrom:
      secretKeyRef:
        name: agl-lite-keys
        key: AGL_KEY
        optional: true
  - name: ANTHROPIC_API_KEY
    valueFrom:
      secretKeyRef:
        name: agl-lite-keys
        key: AGL_KEY
        optional: true
  - name: OPENAI_BASE_URL
    value: "{{ base_url }}/rollout/{{ rollout_id }}/attempt/$(AGL_POD_UID)/v1"
  - name: ANTHROPIC_BASE_URL
    value: "{{ base_url }}/rollout/{{ rollout_id }}/attempt/$(AGL_POD_UID)"
  - name: AGL_EVENT_URL
    value: "{{ base_url }}/rollout/{{ rollout_id }}/attempt/$(AGL_POD_UID)/events"
  - name: AGL_ROLLOUT_ID
    value: "{{ rollout_id }}"
  - name: AGL_ATTEMPT_ID
    value: "$(AGL_POD_UID)"
  # AGL_LOG_DIR references $(AGL_ATTEMPT_ID) — must appear after it (K8s resolves in order).
  - name: AGL_LOG_DIR
    value: "/agl/logs/$(AGL_ATTEMPT_ID)"
volume_mounts:
  - name: agl-logs
    mountPath: /agl/logs
volumes:
  - name: agl-logs
    hostPath:
      path: /tmp/agl-lite/logs
      type: DirectoryOrCreate
