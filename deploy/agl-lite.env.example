# agl-lite deployment configuration.
# Copy to deploy/agl-lite.env and edit before deploying.
#
# Usage:
#   export AGL_KEY=$(openssl rand -hex 32)   # never put AGL_KEY in this file
#   agl-lite deploy --env-file deploy/agl-lite.env
#
# This file is also the single project config — add hook config, model
# endpoints, and experiment params here. Extra vars are ignored by the
# deploy command and consumed by other components via os.environ.

# ── Core ──────────────────────────────────────────────────────────
AGL_NAMESPACE=agl
AGL_MODE=agl-in-k8s
# AGL_MODE=agl-in-host
# AGL_MODE=agl-external

# ── Network ───────────────────────────────────────────────────────
# URL reachable by Kubernetes pods.
#   agl-in-k8s:   must be unset (auto: http://agl-lite.<namespace>.svc:8080)
#   agl-in-host:  optional on minikube (auto: host.minikube.internal:<port>),
#                 required on non-minikube
#   agl-external: required
# AGL_BASE_URL_K8S_ACCESSIBLE=http://host.minikube.internal:8080

AGL_HOST_IP_BIND=0.0.0.0
AGL_HOST_PORT=8080

# ── Controller ────────────────────────────────────────────────────
# Optional: path to a custom Jinja2 job manifest template.
# Defaults to deploy/controller/job-template.yaml.j2 when unset.
# AGL_JOB_MANIFEST_TEMPLATE=/path/to/job-template.yaml.j2

# ── Server runtime ────────────────────────────────────────────────
# AGL_GATEWAY_CONFIG=examples/swe_bench/gateway-config.yaml
# AGL_HOOKS=examples/swe_bench/hooks.py
# AGL_ARTIFACT_DIR=/data/artifacts

# ── Deploy ────────────────────────────────────────────────────────
AGL_WAIT_READY_TIMEOUT_SECONDS=120
AGL_LOCAL_STATE_DIR=.local
