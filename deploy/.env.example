# agl-lite deployment configuration.
# Copy to deploy/.env and edit before deploying.
#
# Two deployment modes (controlled by scripts/deploy.sh):
#
#   Default (in-cluster):
#     Both agl-lite server and controller run inside K8s.
#     AGL_LITE_URL is auto-set — leave it commented out or blank.
#     Run: scripts/deploy.sh
#
#   --controller-only:
#     Only the controller runs in K8s. The agl-lite server runs externally
#     on the compute backend, colocated with model servers (vLLM).
#     Set AGL_LITE_URL below to the external server address.
#     On minikube, deploy.sh auto-patches CoreDNS for host.minikube.internal.
#     Run: scripts/deploy.sh --controller-only

# ── Infrastructure ────────────────────────────────────────────────
# Shared API key — used by all components (serve, controller, agents).
# Uncomment and set, or export AGL_KEY in your shell before deploying.
# AGL_KEY=change-me-to-a-random-key

# K8s namespace for all agl-lite resources.
AGL_K8S_NAMESPACE=agl

# URL of the agl-lite server (as seen from inside K8s).
# Only needed for --controller-only mode. In default mode, auto-set by deploy.sh.
# For minikube --controller-only: use host.minikube.internal.
# AGL_LITE_URL=http://host.minikube.internal:8080

# K8s Secret name holding AGL_KEY.
AGL_SECRET_NAME=agl-lite-keys

# Controller settings.
AGL_POLL_INTERVAL=10
AGL_MAX_QUEUE_TIME=3600
