# agl-lite deploy configuration (non-secret).
#
# Secret handling:
#   export AGL_KEY=$(openssl rand -hex 32)
# then run:
#   agl-lite deploy --config deploy/agl-lite.yaml.example

# Kubernetes namespace where agl-lite/controller resources are deployed.
namespace: agl

# Deployment mode:
#   agl-in-k8s   -> agl-lite server + controller in K8s
#   agl-in-host  -> agl-lite serve on host + controller in K8s
#   agl-external -> external agl-lite + controller in K8s
mode: agl-in-k8s

# URL reachable by Kubernetes pods.
# - agl-in-k8s: must be unset (auto: http://agl-lite.<namespace>.svc:8080)
# - agl-in-host: optional on minikube (auto: host.minikube.internal), required on non-minikube
# - agl-external: required
# agl_base_url_k8s_accessible: http://host.minikube.internal:8080

# Host-side agl-lite serve bind/port (used in agl-in-host, and host output URL in agl-in-k8s).
agl_host_ip_bind: 0.0.0.0
agl_host_port: 8080

# Controller reconcile settings.
controller:
  poll_interval_seconds: 10
  max_queue_time_seconds: 3600

# Optional agl-lite server runtime paths.
# Passed to `agl-lite serve` in agl-in-host and injected as env vars in agl-in-k8s.
server_runtime:
  gateway_config: null
  hooks: null
  artifact_dir: null

# Deployment wait timeout for readiness checks.
wait_ready_timeout_seconds: 120

# Local directory for generated files (env output, host PID/log).
local_state_dir: .local
